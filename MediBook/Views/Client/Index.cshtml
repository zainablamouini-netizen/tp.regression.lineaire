@model IEnumerable<MediBook.Models.Client>

@{
    ViewData["Title"] = "Clients";
}
<h1>Liste des clients</h1>

<p>
    <a asp-action="Create">Ajouter un client</a>
</p>

<table>
    <thead>
        <tr>
            <th>Nom</th>
            <th>Prénom</th>
            <th>E-mail</th>
            <th>Téléphone</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var client in Model)
        {
            <tr>
                <td>@client.LastName</td>
                <td>@client.FirstName</td>
                <td>@client.Email</td>
                <td>@client.Phone</td>
                <td>
                    <a asp-action="Details" asp-route-id="@client.Id">Détails</a> |
                    <a asp-action="Edit" asp-route-id="@client.Id">Modifier</a> |
                    <a asp-action="Delete" asp-route-id="@client.Id">Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>
